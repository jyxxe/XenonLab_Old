[Unit]
Description=Collect configured physical ZFS pool capacity for HF-cache
After=local-fs.target network-online.target
Wants=network-online.target
Requires=xeonolab-pool-telemetry-firewall.service
After=xeonolab-pool-telemetry-firewall.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/xeonolab/pool-telemetry.env
ExecStart=/usr/bin/python3 /usr/local/libexec/xeonolab-pool-telemetry-collector
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/zfs rw
CapabilityBoundingSet=CAP_SYS_ADMIN
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
MemoryMax=64M
TasksMax=8
TimeoutStartSec=25s
IPAddressDeny=any
IPAddressAllow=192.168.0.103/32
