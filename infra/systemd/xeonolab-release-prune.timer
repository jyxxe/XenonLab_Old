[Unit]
Description=Daily XeonoLab release retention (keep current + 3 rollback releases)

[Timer]
# Daily low-traffic window plus boot catch-up, so a target that stayed up for
# weeks cannot silently fill /opt with release directories again.
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=20min
Persistent=true
Unit=xeonolab-release-prune.service

[Install]
WantedBy=timers.target
