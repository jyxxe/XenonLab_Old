[Unit]
Description=Verified nightly Keycloak PostgreSQL dump (keep newest 7, local disk)
Documentation=https://xenon.jyxxe.com/dev/xenon-admin/XeonoLab/src/branch/feature/platform-v1/docs/runbooks/keycloak-backup-restore.md
ConditionPathExists=/var/lib/postgresql/18/main
ConditionPathExists=/usr/local/libexec/xeonolab-postgres-backup

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/xeonolab-postgres-backup.sh
Nice=15
IOSchedulingClass=idle
Restart=no
TimeoutStartSec=900
