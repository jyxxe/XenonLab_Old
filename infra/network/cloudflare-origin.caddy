import security-headers.caddy

http://xenon.jyxxe.com:8080, http://*.xenon.jyxxe.com:8080 {
  bind 192.168.0.101
  import security_headers
  @outside not remote_ip 192.168.0.105 192.168.0.101
  handle @outside {
    respond "Tunnel connector required" 403
  }
  handle_path /auth/* {
    reverse_proxy 192.168.0.109:8180 {
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Prefix /auth
    }
  }
  handle_path /dev/* {
    reverse_proxy 192.168.0.110:3000 {
      header_up X-Forwarded-Proto https
    }
  }
  redir /dev /dev/ 308
  @auth host auth.xenon.jyxxe.com
  handle @auth {
    reverse_proxy 192.168.0.109:8180 {
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto https
    }
  }
  @dev host dev.xenon.jyxxe.com
  handle @dev {
    reverse_proxy 192.168.0.110:3000 {
      header_up X-Forwarded-Proto https
    }
  }
  @chat host chat.xenon.jyxxe.com
  handle @chat {
    reverse_proxy 192.168.0.100:3000 {
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {host}
    }
  }
  @embedding_api path /api/v1/embed/*
  handle @embedding_api {
    reverse_proxy 192.168.0.107:8104
  }
  @desktop_api path /api/v1/apps* /api/v1/users/* /api/v1/auth/* /api/v1/plugins*
  handle @desktop_api {
    reverse_proxy 127.0.0.1:8101
  }
  @work_api path /api/v1/work* /api/v1/issues/*
  handle @work_api {
    reverse_proxy 192.168.0.111:8106
  }
  handle /api/v1/* {
    reverse_proxy 192.168.0.104:8100
  }
  handle /health/* {
    reverse_proxy 127.0.0.1:8101
  }
  handle {
    root * /opt/xeonolab/current/apps/desktop-web/dist
    try_files {path} /index.html
    file_server
  }
}
