{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenon.lan/schemas/capability-manifest.json",
  "title": "XeonoLab capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "api_version", "source", "capabilities"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,62}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "api_version": {"const": "1"},
    "source": {"enum": ["builtin", "declared"]},
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "maxLength": 400},
        "icon": {"type": "string", "maxLength": 8}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "version", "runtime", "permissions", "dependencies"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "kind": {"enum": ["app", "widget", "tool", "agent", "provider", "worker"]},
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
          "runtime": {"enum": ["ui", "api", "service"]},
          "permissions": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9-]+$"}, "uniqueItems": true},
          "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$@[~^]?[0-9]+\\.[0-9]+\\.[0-9]+$"}, "uniqueItems": true},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
        }
      }
    }
  }
}
