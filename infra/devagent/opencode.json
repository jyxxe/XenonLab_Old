{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "maintainer",
  "share": "disabled",
  "autoupdate": false,
  "plugin": [],
  "enabled_providers": ["opencode-go"],
  "instructions": ["/etc/devagent/maintainer.md"],
  "agent": {
    "maintainer": {
      "description": "XeonoLab autonomous code, PR and deployment maintainer",
      "mode": "primary",
      "steps": 32,
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "**/auth.json": "deny",
          "**/*token*": "deny",
          "**/*password*": "deny",
          "**/*credential*": "deny",
          "**/*secret*": "deny"
        },
        "edit": {
          "*": "allow",
          "**/.git/config": "deny",
          "**/.opencode/**": "deny",
          "**/opencode.json*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": {
          "*": "ask",
          "git *": "allow",
          "rg *": "allow",
          "ls*": "allow",
          "pwd": "allow",
          "cat *": "allow",
          "sed *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "uv run *": "allow",
          "uv sync *": "allow",
          "npm ci*": "allow",
          "npm run *": "allow",
          "python* -m pytest*": "allow",
          "python* scripts/export_openapi.py*": "allow",
          "devctl *": "allow",
          "git push --force*": "deny",
          "git reset --hard*": "deny",
          "git clean *": "deny",
          "git credential *": "deny",
          "git config *": "deny",
          "*auth.json*": "deny",
          "*forgejo-token*": "deny",
          "*password*": "deny",
          "*secret*": "deny",
          "* /etc/*": "deny",
          "sudo *": "deny",
          "ssh *": "deny",
          "scp *": "deny",
          "curl *": "deny",
          "wget *": "deny",
          "rm *": "deny"
        },
        "external_directory": "deny",
        "todowrite": "allow"
      }
    },
    "build": {"disable": true},
    "plan": {"disable": true},
    "general": {"disable": true},
    "explore": {"disable": true}
  }
}
