#!/usr/bin/python3 -I
# LAN-only launcher for the DeepSeek Harness Web UI on VM111.
# It resolves the current per-process launch token from the harness service
# journal and redirects the operator to the token-bearing URL, so no token is
# stored in the repository or in the desktop app.
import http.server
import re
import subprocess
import time

BIND = "192.168.0.111"
PORT = 4097
SERVICE = "devagent-harness-web.service"
TOKEN_URL = re.compile(r"http://192\.168\.0\.111:4096/\?token=([A-Za-z0-9_-]+)")
JOURNAL = "/usr/bin/journalctl"
CACHE_SECONDS = 15.0
_cached = {"token": None, "at": 0.0}


def current_token():
    now = time.monotonic()
    if _cached["token"] and now - _cached["at"] < CACHE_SECONDS:
        return _cached["token"]
    try:
        output = subprocess.run(
            [JOURNAL, "-u", SERVICE, "--no-pager", "-o", "cat"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        output = ""
    matches = TOKEN_URL.findall(output)
    token = matches[-1] if matches else None
    _cached["token"], _cached["at"] = token, now
    return token


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "dsh-harness-launch"

    def do_GET(self):
        if self.path in ("/", "/harness", "/harness/"):
            token = current_token()
            if not token:
                self.send_error(503, "Harness token unavailable")
                return
            self.send_response(302)
            self.send_header("Location", "http://192.168.0.111:4096/?token=" + token)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
        elif self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"ok")
        else:
            self.send_error(404)

    def log_message(self, fmt, *args):
        return


if __name__ == "__main__":
    http.server.ThreadingHTTPServer((BIND, PORT), Handler).serve_forever()
