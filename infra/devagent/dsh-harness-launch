#!/usr/bin/python3 -I
# LAN-only launcher for the DeepSeek Harness Web UI on VM111.
#
# It resolves the current per-process launch token from the harness service
# journal, exchanges it for the Harness browser-session cookie server-side and
# hands that cookie to the operator's browser from this VM111 host, then
# redirects to the Harness UI.  The token is never stored in the repository or
# in the desktop app and rotates with the harness process.
import http.server
import re
import subprocess
import time
import urllib.error
import urllib.request

BIND = "192.168.0.111"
PORT = 4097
HARNESS = "http://192.168.0.111:4096"
SERVICE = "devagent-harness-web.service"
TOKEN_URL = re.compile(r"http://192\.168\.0\.111:4096/\?token=([A-Za-z0-9_-]+)")
JOURNAL = "/usr/bin/journalctl"
CACHE_SECONDS = 15.0
_cached_token = {"token": None, "at": 0.0}
_cached_cookie = {"header": None, "expires": 0.0}


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


_opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect)


def current_token():
    now = time.monotonic()
    if _cached_token["token"] and now - _cached_token["at"] < CACHE_SECONDS:
        return _cached_token["token"]
    try:
        output = subprocess.run(
            [JOURNAL, "-u", SERVICE, "--no-pager", "-o", "cat"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        output = ""
    matches = TOKEN_URL.findall(output)
    token = matches[-1] if matches else None
    _cached_token["token"], _cached_token["at"] = token, now
    return token


def _cookie_header(response):
    """Return the browser-session Set-Cookie value from the exchange response."""
    for name, value in response.headers.items():
        if name.lower() != "set-cookie":
            continue
        first = value.split(";", 1)[0].strip()
        if "dsh-auth-" in first and "=" in first:
            return first
    return None


def _cookie_authenticates(header):
    if not header:
        return False
    request = urllib.request.Request(HARNESS + "/", headers={"Cookie": header})
    try:
        with _opener.open(request, timeout=5) as response:
            return response.status == 200
    except (OSError, urllib.error.URLError, urllib.error.HTTPError):
        return False


def browser_cookie():
    """Exchange the launch token for a Harness cookie, caching it until invalid."""
    if _cached_cookie["header"] and _cached_cookie["expires"] > time.monotonic():
        return _cached_cookie["header"]
    token = current_token()
    if not token:
        return None
    request = urllib.request.Request(HARNESS + "/?token=" + token)
    header = None
    try:
        with _opener.open(request, timeout=5) as response:
            header = _cookie_header(response)
    except urllib.error.HTTPError as error:
        header = _cookie_header(error)
    except (OSError, urllib.error.URLError):
        return None
    if not header or not _cookie_authenticates(header):
        return None
    _cached_cookie["header"], _cached_cookie["expires"] = header, time.monotonic() + 600.0
    return header


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "dsh-harness-launch"

    def do_GET(self):
        if self.path in ("/", "/harness", "/harness/"):
            # Send the browser to this VM's own launch page so the cookie is
            # scoped to the Harness host, then the meta refresh navigates
            # same-site and the Strict cookie is accepted by the Harness UI.
            self.send_response(302)
            self.send_header("Location", "http://192.168.0.111:4097/launch")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            return
        if self.path == "/launch":
            header = browser_cookie()
            if not header:
                self.send_error(503, "Harness session unavailable")
                return
            page = (
                "<!doctype html><html lang=\"zh\"><head><meta charset=\"utf-8\">"
                "<meta http-equiv=\"refresh\" content=\"0; url=" + HARNESS + "/\">"
                "<title>DeepSeek Harness</title></head><body>"
                "<p>正在打开 DeepSeek Harness…</p>"
                "<p>如果没有自动跳转，请<a href=\"" + HARNESS + "/\">继续</a>。</p>"
                "</body></html>"
            ).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Set-Cookie", header + "; Path=/; HttpOnly; SameSite=Strict")
            self.send_header("Content-Length", str(len(page)))
            self.end_headers()
            self.wfile.write(page)
            return
        if self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"ok")
            return
        self.send_error(404)

    def log_message(self, fmt, *args):
        return


if __name__ == "__main__":
    http.server.ThreadingHTTPServer((BIND, PORT), Handler).serve_forever()
