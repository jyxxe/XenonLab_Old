  "components": {
    "schemas": {
      "AppEntry": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Title"
          },
          "origin": {
            "type": "string",
            "maxLength": 2048,
            "title": "Origin"
          },
          "entry": {
            "type": "string",
            "maxLength": 2048,
            "title": "Entry",
            "default": "/"
          },
          "icon": {
            "type": "string",
            "maxLength": 64,
            "title": "Icon",
            "default": "\u25c7"
          },
          "default_size": {
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Default Size",
            "default": [
              1000,
              700
            ]
          },
          "singleton": {
            "type": "boolean",
            "title": "Singleton",
            "default": true
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Permissions"
          },
          "sandbox": {
            "$ref": "#/components/schemas/Sandbox"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "origin"
        ],
        "title": "AppEntry"
      },
      "AppPatch": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "origin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin"
          },
          "entry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entry"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "default_size": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Size"
          },
          "singleton": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Singleton"
          },
          "permissions": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Permissions"
          },
          "sandbox": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Sandbox"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AppPatch"
      },
      "Bootstrap": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "default": "\u7ba1\u7406\u5458"
          }
        },
        "type": "object",
        "title": "Bootstrap"
      },
      "Child": {
        "properties": {
          "parent_id": {
            "type": "string",
            "title": "Parent Id"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,63}$",
            "title": "Username"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Password"
          },
          "inherit_all": {
            "type": "boolean",
            "title": "Inherit All",
            "default": false
          },
          "grants": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Grants"
          }
        },
        "type": "object",
        "required": [
          "parent_id",
          "username",
          "name",
          "password"
        ],
        "title": "Child"
      },
      "Exchange": {
        "properties": {
          "code": {
            "type": "string",
