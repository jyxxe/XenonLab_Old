  "components": {
    "schemas": {
      "Ensure": {
        "properties": {
          "repo_type": {
            "type": "string",
            "pattern": "^(model|dataset|space)$",
            "title": "Repo Type",
            "default": "model"
          },
          "repo_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
            "title": "Repo Id"
          },
          "revision": {
            "type": "string",
            "maxLength": 40,
            "minLength": 40,
            "pattern": "^[0-9a-f]{40}$",
            "title": "Revision"
          },
          "allow_patterns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 128,
            "title": "Allow Patterns"
          },
          "ignore_patterns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 128,
            "title": "Ignore Patterns"
          },
          "priority": {
            "type": "string",
            "pattern": "^(low|normal|production)$",
            "title": "Priority",
            "default": "normal"
          },
          "pin": {
            "type": "boolean",
            "title": "Pin",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "repo_id",
          "revision"
        ],
        "title": "Ensure"
      },
      "GCRequest": {
        "properties": {
          "target_usage_percent": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Target Usage Percent",
            "default": 75
          }
        },
        "type": "object",
        "title": "GCRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
