  "components": {
    "schemas": {
      "Acquire": {
        "properties": {
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "release_id": {
            "type": "string",
            "title": "Release Id"
          },
          "ttl_seconds": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 15.0,
            "title": "Ttl Seconds",
            "default": 60
          }
        },
        "type": "object",
        "required": [
          "agent_id",
          "release_id"
        ],
        "title": "Acquire"
      },
      "Artifact": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "title": "Name"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$",
            "title": "Digest"
          }
        },
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "title": "Artifact"
      },
      "Deployment": {
        "properties": {
          "release_id": {
            "type": "string",
            "title": "Release Id"
          },
          "environment": {
            "type": "string",
            "pattern": "^production$",
            "title": "Environment",
            "default": "production"
          },
          "lease_id": {
            "type": "string",
            "title": "Lease Id"
          },
          "epoch": {
            "type": "integer",
            "title": "Epoch"
          }
        },
        "type": "object",
        "required": [
          "release_id",
          "lease_id",
          "epoch"
        ],
        "title": "Deployment"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Release": {
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$",
            "title": "Commit"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/Artifact"
            },
            "type": "array",
            "minItems": 1,
            "title": "Artifacts"
          },
          "migration_manifest": {
            "type": "string",
            "title": "Migration Manifest"
          },
          "test_report": {
            "type": "string",
            "minLength": 1,
            "title": "Test Report"
          }
        },
        "type": "object",
        "required": [
          "commit",
          "artifacts",
          "migration_manifest",
          "test_report"
        ],
        "title": "Release"
      },
      "Renew": {
        "properties": {
          "ttl_seconds": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 15.0,
            "title": "Ttl Seconds",
            "default": 60
          }
        },
        "type": "object",
        "title": "Renew"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
