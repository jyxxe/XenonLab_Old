          "413": {
            "description": "Request body exceeds the configured byte limit."
          },
          "429": {
            "description": "Per-process stream capacity reached; includes Retry-After."
          },
          "502": {
            "description": "Provider request failed before streaming began, or JSON completion failed."
          },
          "504": {
            "description": "Provider request exceeded its deadline before streaming began or during JSON completion."
          }
        }
      }
